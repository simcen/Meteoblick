{
  "name": "meteoblick",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.5.0",
    "@callstack/liquid-glass": "^0.8.2",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/virtualized-lists": "^0.88.1",
    "@react-navigation/drawer": "^7.12.7",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/stack": "^7.10.11",
    "expo": "~58.0.26",
    "expo-background-fetch": "~58.0.13",
    "expo-blur": "~58.0.6",
    "expo-crypto": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-modules-core": "~58.1.0",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-widgets": "~58.0.29",
    "papaparse": "^5.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-shared-group-preferences": "^1.1.24",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "ios": "expo run:ios --device 'iPhone 17 Pro'",
    "ios:clean": "rm -rf ios/build && expo run:ios --device 'iPhone 17 Pro'",
    "ios:widget": "pnpm ios && ./scripts/reset-widget.sh",
    "ios:bundle": "npx expo export:embed --entry-file index.ts --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "ios:archive": "pnpm ios:bundle && ./scripts/archive-ios.sh",
    "ios:upload": "./scripts/upload-testflight.sh",
    "ios:install": "cd ios && xcrun devicectl device install app --device $(xcrun devicectl list devices 2>/dev/null | grep 'iPhone' | grep 'connected' | awk '{print $3}' | head -1) build/Meteoblick.xcarchive/Products/Applications/Meteoblick.app",
    "ios:deploy": "./scripts/deploy-ios.sh",
    "ios:deploy:force": "pnpm ios:archive && pnpm ios:install",
    "widget:reset": "./scripts/reset-widget.sh",
    "android": "expo run:android",
    "web": "expo start --web",
    "clean": "rm -rf node_modules/.cache && rm -rf .expo && watchman watch-del-all 2>/dev/null || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:backend": "cd backend && pnpm test",
    "test:all": "pnpm test && pnpm test:backend && pnpm test:e2e",
    "heroku:push": "./scripts/deploy-heroku.sh",
    "prebuild": "expo prebuild",
    "postprebuild": "node plugins/widget-custom/patch.js",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
