NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/meteoblick
API_BASE_URL=http://localhost:3000
ENABLE_CRON=true
ADMIN_TOKEN=your-secret-admin-token-here
# Pre-shared secret between app/widget and API (Authorization: Bearer ...).
# Generate with: openssl rand -base64 32
API_TOKEN=your-secret-api-token-here
# Loxone Miniserver in the backend's network (optional)
LOXONE_BASE_URL=http://192.168.1.47
LOXONE_USERNAME=miniserver-user
LOXONE_PASSWORD=miniserver-password
